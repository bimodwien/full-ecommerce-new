# Copy to .env in the production folder and fill in. Never commit the real .env.
DATABASE_URL=postgresql://tokopakbimo:PASSWORD@localhost:5432/tokopakbimo_prod
# Generate with: openssl rand -base64 48
SECRET_KEY=
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Midtrans keys. The client key is also baked into the web build.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Switch to https://app.midtrans.com/snap/snap.js together with production keys.
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Gmail address and App Password for the newsletter email. Optional.
SMTP_USER=you@gmail.com
SMTP_PASS=

# Seller account that owns the seeded products (docker compose exec api npx prisma db seed).
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
