# Copy to .env.development for local dev (production reads .env).
# The seed command reads .env only.

PORT=8000
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce"

# Long random string, e.g. openssl rand -base64 32
SECRET_KEY="replace-me-with-a-long-random-string"

# Frontend origin for CORS, no trailing slash.
CLIENT_URL="http://localhost:3000"

# This API's origin for image URLs, without /api.
API_BASE_URL="http://localhost:8000"

GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# Midtrans sandbox keys. The client key is also needed by the web app.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# Seller account that owns the seeded products (npx prisma db seed).
SEED_SELLER_EMAIL="seller@example.com"
SEED_SELLER_PASSWORD="replace-me"

# Gmail address and App Password for the newsletter email. Optional.
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
