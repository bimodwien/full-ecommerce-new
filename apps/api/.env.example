# ---------------------------------------------------------------------------
# API environment variables
#
# Copy this file to `.env.development` for local development:
#   cp .env.example .env.development
#
# The app picks its env file based on NODE_ENV (see src/config.ts):
#   development -> .env.development
#   production  -> .env
# A matching `.env.development.local` / `.env.local` is loaded afterwards and
# overrides these values, which is handy for machine-specific secrets.
#
# NODE_ENV is deliberately not listed below: the `dev` and `serve` npm scripts
# set it via cross-env, and config.ts reads it to decide which of these files
# to load in the first place — so setting it inside the file is too late.
# ---------------------------------------------------------------------------

# Port the API listens on. The frontend defaults to expecting 8000.
PORT=8000

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce"

# Secret used to sign and verify JWTs. Use a long random string.
# e.g. generate one with: openssl rand -base64 32
SECRET_KEY="replace-me-with-a-long-random-string"

# Origin of the frontend. Used for the CORS allowlist, so this must match
# exactly where the web app runs (no trailing slash).
CLIENT_URL="http://localhost:3000"

# Origin of this API, used to build absolute product image URLs.
# NOTE: the code appends `/api/products/image/...` itself, so this must NOT
# include the /api suffix — unlike the web app's NEXT_PUBLIC_BASE_API_URL,
# which does. Leave it empty and image URLs come back relative instead.
API_BASE_URL="http://localhost:8000"

# --- Google Sign-In ---------------------------------------------------------
# OAuth 2.0 Client ID used to verify the ID token the browser sends on Google
# login (it is checked as the token's `audience`).
# Get it from https://console.cloud.google.com/ -> APIs & Services ->
# Credentials -> OAuth 2.0 Client IDs -> Web application.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# --- Midtrans (payment gateway) ---------------------------------------------
# Get these from https://dashboard.sandbox.midtrans.com/ -> Settings -> Access Keys.
#
# The SERVER key is a secret: it signs Snap requests and verifies the SHA-512
# signature on incoming payment webhooks. Never expose it to the browser.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"

# The CLIENT key is safe to expose; the frontend needs the same value.
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"

# false -> Midtrans sandbox, true -> Midtrans production.
# Keep this false unless you are intentionally taking real payments.
MIDTRANS_IS_PRODUCTION=false
