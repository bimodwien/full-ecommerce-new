# ---------------------------------------------------------------------------
# Web environment variables
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Every variable here is prefixed with NEXT_PUBLIC_, which means Next.js inlines
# it into the client bundle. Only ever put values here that are safe to be
# public — secrets belong in the API's environment instead.
# ---------------------------------------------------------------------------

# Base URL of the API, including the /api prefix.
# Must point at the same port the API's PORT is set to.
NEXT_PUBLIC_BASE_API_URL="http://localhost:8000/api"

# Midtrans CLIENT key — the browser needs this to open the Snap popup.
# This is the public half of the key pair; the SERVER key stays in the API.
# Get it from https://dashboard.sandbox.midtrans.com/ -> Settings -> Access Keys.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
