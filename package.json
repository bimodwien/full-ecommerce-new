{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "serve": "turbo run serve",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "postprepare": "bash -c 'chmod ug+x .husky/*'"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "tsconfig": "*",
    "turbo": "^2.10.12"
  },
  "name": "finpro-nextjs-express-prisma",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  },
  "dependencies": {
    "google-auth-library": "11.0.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "cypress@15.19.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
